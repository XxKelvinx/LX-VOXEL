function(lxvoxel_apply_optimizations target)
  if(MSVC)
    target_compile_options(${target} PRIVATE /O2)
  else()
    target_compile_options(${target} PRIVATE -O2 -ffast-math -fno-finite-math-only)
    if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
      target_compile_options(${target} PRIVATE -fno-semantic-interposition)
    endif()
    if(LXVOXEL_NATIVE)
      target_compile_options(${target} PRIVATE -march=native -mtune=native)
    endif()
  endif()
endfunction()

# ISA-independent dispatcher / glue code.
function(lxvoxel_apply_portable_optimizations target)
  if(MSVC)
    target_compile_options(${target} PRIVATE /O2)
  else()
    target_compile_options(${target} PRIVATE -O2 -ffast-math -fno-finite-math-only)
  endif()
endfunction()

# Production x86 baseline. SSE4.1 is required intentionally: it keeps one
# reasonably modern baseline while enabling useful integer SIMD in entropy code.
function(lxvoxel_apply_sse41_optimizations target)
  if(MSVC)
    # MSVC x64 has SSE2 baseline but no /arch:SSE4.1 switch. Intrinsics used by
    # this path are emitted explicitly; runtime deployment requires SSE4.1.
    target_compile_options(${target} PRIVATE /O2)
    target_compile_definitions(${target} PRIVATE LXVOXEL_SSE41=1)
  else()
    target_compile_options(${target} PRIVATE
      -O2 -ffast-math -fno-finite-math-only -msse4.1)
    target_compile_definitions(${target} PRIVATE LXVOXEL_SSE41=1)
    if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
      target_compile_options(${target} PRIVATE -fno-semantic-interposition)
    endif()
  endif()
endfunction()

function(lxvoxel_apply_avx2_optimizations target)
  if(MSVC)
    target_compile_options(${target} PRIVATE /O2 /arch:AVX2)
    target_compile_definitions(${target} PRIVATE __AVX2__=1 LXVOXEL_AVX2_FMA=1)
  else()
    target_compile_options(${target} PRIVATE
      -O2 -finline-functions  -ffast-math -fno-finite-math-only -mavx2 -mfma)
    target_compile_definitions(${target} PRIVATE LXVOXEL_AVX2_FMA=1)
    if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
      target_compile_options(${target} PRIVATE -fno-semantic-interposition)
    endif()
    if(LXVOXEL_NATIVE)
      target_compile_options(${target} PRIVATE -mtune=native)
    endif()
  endif()
endfunction()

function(lxvoxel_apply_neon_optimizations target)
  if(MSVC)
    target_compile_options(${target} PRIVATE /O2)
    target_compile_definitions(${target} PRIVATE LXVOXEL_NEON=1)
  else()
    target_compile_options(${target} PRIVATE -O2 -ffast-math -fno-finite-math-only)
    target_compile_definitions(${target} PRIVATE LXVOXEL_NEON=1)
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm|ARM)" AND NOT CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|AARCH64|arm64|ARM64")
      target_compile_options(${target} PRIVATE -mfpu=neon)
    endif()
    if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
      target_compile_options(${target} PRIVATE -fno-semantic-interposition)
    endif()
  endif()
endfunction()
